# API runtime
MODEL_ARTIFACT_DIR=backend/artifacts
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Persistence is deliberately off unless explicitly enabled.
PERSISTENCE_ENABLED=false
